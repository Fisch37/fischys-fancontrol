{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // c.f. https://github.com/vadimcn/codelldb/blob/master/MANUAL.md#remote-debugging
        //      https://github.com/vadimcn/codelldb/blob/master/MANUAL.md#debugging-as-a-different-user
        {
            "name": "Service",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/fischys-fancontrol", // Local path.
            "args": [ "service" ],
            "initCommands": [
                "platform select remote-linux", // Replace with "remote-macosx" or "remote-windows" as appropriate
                "platform connect connect://127.0.0.1:12345"
            ],
            "env": {
                "RUST_LOG": "info"
            }
        },
    ]
}